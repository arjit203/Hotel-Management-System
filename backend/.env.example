# ==== App ====
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001

# ==== Database (MongoDB) ====
MONGODB_URI=mongodb://localhost:27017/vachan_dev
# For MongoDB Atlas (cloud), it'll look like:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/vachan_dev?retryWrites=true&w=majority

# ==== Auth ====
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=1d

# ==== Payments (Razorpay) ====
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==== Email (transactional) ====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="7 Vachan <no-reply@7vachan.com>"

# ==== SMS / WhatsApp ====
WHATSAPP_API_URL=https://your-whatsapp-provider.example.com
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token
SMS_PROVIDER_API_KEY=your_sms_provider_key

# ==== Google ====
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_BUSINESS_PROFILE_API_KEY=your_gbp_api_key

# ==== File Storage ====
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ==== Rate Limiting ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
